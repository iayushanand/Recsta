# Copy to .env and fill from Supabase Dashboard > Project Settings
SUPABASE_URL=
SUPABASE_ANON_KEY=sb_publishable_...   # or eyJhbG... anon key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_... # service_role, keep secret - server only, bypasses RLS
SUPABASE_JWT_SECRET=your-jwt-secret-from-dashboard # Settings > API > JWT Secret (for verifying Supabase JWTs)

PORT=8000
ENV=development
CORS_ORIGINS=*
